# Copy to .env.local and fill values locally.
# Never commit .env.local or paste secret values into docs/history.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.6-27b
QWEN_ENABLE_THINKING=false
QWEN_MAX_TOKENS=96
DASHSCOPE_API_KEY_COSYVOICE=
COSYVOICE_WS_URL=
COSYVOICE_CLONE_URL=
COSYVOICE_MODEL=cosyvoice-v3-plus
DEEPGRAM_API_KEY=
# Classroom Kit/Kai use Deepgram's integrated listen/think/speak Voice Agent.
DEEPGRAM_AGENT_ENABLED=true
DEEPGRAM_AGENT_TIMEOUT_SECONDS=60
